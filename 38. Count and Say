class Solution {
    string rle(const string& s){
        int n=s.size(),cnt=1;
        string ans="",temp;
        bool once=true;
        for(int i=0;i<n-1;++i){
            if(s[i]==s[i+1]) ++cnt;
            else{
                temp=to_string(cnt);
                ans+=temp;
                ans+=s[i];
                cnt=1;
            }
        }
        if (s[n-1]!=s[n-2]){
            ans+="1";
            ans+=s[n-1];
        }
        else{
            temp=to_string(cnt);
            ans+=temp;
            ans+=s[n-1];
        }
        return ans;

    }
public:
    string countAndSay(int n) {
        if (n==1) return "1";
        if (n==2) return "11";
        if (n==3) return "21";
        return rle(countAndSay(n-1));
    }
};
