class Solution {
    int countstring(const string& s){
        int ans=0;
        for(char c:s){
            ans+=(c-'0');
        }
        return ans;
    }
    bool issymmetric(const int& x){
        string s=to_string(x);
        int n=s.size();
        if(n%2==1) return 0;
        string s1=s.substr(0,n/2),s2=s.substr(n/2,n/2);
        return countstring(s1)==countstring(s2);
    }
public:
    int countSymmetricIntegers(int low, int high) {
        int ans=0;
        for(int i=low;i<=high;++i){
            if (issymmetric(i)) ++ans;
        }
        return ans;
    }
};
