class Solution {
public:
    bool isZeroArray(vector<int>& nums, vector<vector<int>>& queries) {
        int sum=0;
        int n=nums.size();
        vector<int> diff(n+1,0);
        for (vector<int> query :queries){
            diff[query[0]]++;
            diff[query[1]+1]--;
        }
        for(int i=0 ; i<n ; ++i){
            sum+=diff[i];
            if(nums[i]>sum) return false;
        }
        return true;
    }
};
