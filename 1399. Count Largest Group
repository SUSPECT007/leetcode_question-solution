class Solution {
    int sumeverydig(int x){
        int ans=0;
        while(x){
            ans+=(x%10);
            x/=10;
        }
        return ans;
    }
public:
    int countLargestGroup(int n) {
        vector<int> sgroup(37,0);
        int maxn=0,cnt;
        for(int i=1;i<=n;++i) ++sgroup[sumeverydig(i)];
        for( int x: sgroup){
            if(x>maxn){maxn=x;cnt=1;}
            else if(x==maxn) ++cnt;
        }
        return cnt;
    }
};
