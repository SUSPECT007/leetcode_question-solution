class Solution {
public:
    long long minSum(vector<int>& nums1, vector<int>& nums2) {
        int n1_0=0,n2_0=0;
        long long sum1=0,sum2=0;
        for(int i=0;i<nums1.size();++i){
            if (nums1[i]==0) ++n1_0;
            else sum1+=nums1[i];
        }
        for(int i=0;i<nums2.size();++i){
            if (nums2[i]==0) ++n2_0;
            else sum2+=nums2[i];
        }
        long long s1=sum1+n1_0,s2=sum2+n2_0;
        if(s1==s2) return s1;
        if ((s1>s2 && n2_0==0 ) || (s2>s1 && n1_0==0 )) return -1;
        return max(s1,s2);



    }
};
